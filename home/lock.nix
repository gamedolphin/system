# WARNING : This file was generated by README.org
# DO NOT MODIFY THIS FILE!
# Any changes made here will be overwritten.
{ config, pkgs, ... } :
let
  lockCommand = "${pkgs.procps}/bin/pidof swaylock || ${pkgs.swaylock-effects}/bin/swaylock";
in
{
  home.packages = with pkgs; [
    swaylock-effects
    wlogout
  ];


  home.file = {
    lock = {
      source = ../assets/lock.png;
      target = ".lock.png";
    };
  };

  services = {
    # swayidle to
    # 150 seconds - turn of monitor
    # 300 seconds - lock screen
    # 330 seconds - turn of monitor
    #  30 minutes - put to sleep
    swayidle = {
      enable = true;
      events = {
        lock = lockCommand;                                                          # avoid starting multiple swaylock instances.
        before-sleep = "${pkgs.systemd}/bin/loginctl lock-session";                 # lock before suspend.
        after-resume = "${pkgs.niri}/bin/niri msg action power-on-monitors";         # to avoid having to press a key twice to turn on the display.
      };

      timeouts = [
        {
          timeout = 150;                                                            # 2.5min.
          command = "${pkgs.brightnessctl}/bin/brightnessctl -s set 10";             # set monitor backlight to minimum, avoid 0 on OLED monitor.
          resumeCommand = "${pkgs.brightnessctl}/bin/brightnessctl -r";              # monitor backlight restore.
        }
        {
          timeout = 300;                                                            # 5min
          command = "${pkgs.systemd}/bin/loginctl lock-session";                     # lock screen when timeout has passed
        }
        {
          timeout = 330;                                                            # 5.5min
          command = "${pkgs.niri}/bin/niri msg action power-off-monitors";           # screen off when timeout has passed
          resumeCommand = "${pkgs.niri}/bin/niri msg action power-on-monitors && ${pkgs.brightnessctl}/bin/brightnessctl -r"; # screen on when activity is detected after timeout has fired.
        }
        {
          timeout = 1800;                                                           # 30min
          command = "${pkgs.systemd}/bin/systemctl suspend";                        # suspend pc
        }
      ];
    };
  };



  programs.wlogout = {
    enable = true;
    layout = [
      {
        "label"  = "lock";
        "action" = lockCommand;
        "text" = "Lock";
        "keybind" = "l";
      }
      {
        "label" = "shutdown";
        "action" = "systemctl poweroff";
        "text" = "Shutdown";
        "keybind" = "s";
      }
      {
        "label" = "suspend";
        "action" = "systemctl suspend";
        "text" = "Suspend";
        "keybind" = "u";
      }
      {
        "label" = "reboot";
        "action" = "systemctl reboot";
        "text" = "Reboot";
        "keybind" = "r";
      }
      {
        "label" = "hibernate";
        "action" = "systemctl hibernate";
        "text" = "Hibernate";
        "keybind" = "h";
      }
      {
        "label" = "reboot";
        "action" = "systemctl reboot";
        "text" = "Reboot";
        "keybind" = "r";
      }
    ];
  };

  catppuccin.wlogout.iconStyle = "wleave";

  xdg.configFile."swaylock/config".text = ''
    ignore-empty-password
    show-failed-attempts
    daemonize
    image=${config.home.homeDirectory}/.lock.png
    scaling=fill
    indicator
    clock
    timestr=%H:%M
    datestr=%A, %F
    font=Aporetic
    font-size=36
    indicator-radius=110
    indicator-thickness=12
    line-uses-ring
    effect-blur=7x5
    effect-vignette=0.5:0.5
    inside-color=1e1e2ecc
    inside-clear-color=a6e3a1cc
    inside-caps-lock-color=f9e2afcc
    inside-ver-color=89b4facc
    inside-wrong-color=f38ba8cc
    ring-color=89b4fa
    ring-clear-color=a6e3a1
    ring-caps-lock-color=f9e2af
    ring-ver-color=89b4fa
    ring-wrong-color=f38ba8
    key-hl-color=a6e3a1
    bs-hl-color=f38ba8
    text-color=cdd6f4
    text-clear-color=1e1e2e
    text-caps-lock-color=1e1e2e
    text-ver-color=1e1e2e
    text-wrong-color=1e1e2e
    separator-color=00000000
  '';
}
