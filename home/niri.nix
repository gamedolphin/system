        };

        focus-follows-mouse.enable = true;
        mod-key = "Super";
      };

      layout = {
        gaps = 4;
        default-column-width.proportion = 0.5;

        focus-ring = {
          enable = true;
          width = 2;
          active.gradient = {
            from = "#89b4fa";
            to = "#a6e3a1";
            angle = 45;
          };
          inactive.color = "#1e1e2e";
        };

        border.enable = false;
