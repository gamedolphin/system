# WARNING : This file was generated by README.org
# DO NOT MODIFY THIS FILE!
# Any changes made here will be overwritten.
{ pkgs, ... } :
let
  mainOutput = "PNP(AOC) Q3279WG5B 0x00000161";
  laptopOutput = "eDP-1";
in
{
  imports = [
    ../../home
  ];

  home.packages = with pkgs; [
    brightnessctl
    davinci-resolve
  ];

  nambiar.niri.extraConfig = ''
    // Niri reports the external display by make/model/serial, unlike Hyprland's desc: name.
    output "${mainOutput}" {
        scale 1
        position x=0 y=0
        focus-at-startup
    }

    output "${laptopOutput}" {
        scale 1.5
        position x=2560 y=0
    }

    workspace "1" { open-on-output "${mainOutput}"; }
    workspace "2" { open-on-output "${mainOutput}"; }
    workspace "3" { open-on-output "${mainOutput}"; }
    workspace "4" { open-on-output "${mainOutput}"; }
    workspace "5" { open-on-output "${laptopOutput}"; }
    workspace "6" { open-on-output "${laptopOutput}"; }

    spawn-at-startup "firefox"
    spawn-at-startup "emacs"
    spawn-at-startup "slack"

    window-rule {
        match at-startup=true app-id=r#"firefox$"#
        open-on-workspace "1"
    }

    window-rule {
        match at-startup=true app-id=r#"emacs"#
        open-on-workspace "2"
    }

    window-rule {
        match at-startup=true app-id=r#"Slack"#
        match at-startup=true app-id=r#"slack"#
        open-on-workspace "5"
        open-maximized-to-edges true
    }
  '';

  nambiar.niri.extraBinds = ''
    XF86MonBrightnessUp allow-when-locked=true { spawn "brightnessctl" "set" "5%+"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "brightnessctl" "set" "5%-"; }
    XF86AudioRaiseVolume allow-when-locked=true { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "5%+"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "5%-"; }
    XF86AudioMute allow-when-locked=true { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SINK@" "toggle"; }
    XF86AudioMicMute allow-when-locked=true { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SOURCE@" "toggle"; }
  '';
}
